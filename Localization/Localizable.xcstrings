    "Angle, in degrees (G): drag the first arm from the joint, then drag again for the second arm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Winkel in Grad (G): Ziehe den ersten Arm vom Gelenk aus, dann ziehe erneut für den zweiten Arm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ángulo, en grados (G): arrastra el primer brazo desde la articulación y vuelve a arrastrar para el segundo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Angle, en degrés (G) : faites glisser le premier bras depuis l'articulation, puis glissez à nouveau pour le second"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Angolo, in gradi (G): trascina il primo braccio dall'articolazione, poi trascina di nuovo per il secondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "角度（度）（G）：関節から1本目の腕をドラッグし、もう一度ドラッグして2本目の腕を描きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각도(도)(G): 관절에서 첫 번째 팔을 드래그한 다음, 다시 드래그해 두 번째 팔을 그립니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ângulo, em graus (G): arraste o primeiro braço a partir da articulação e arraste de novo para o segundo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угол в градусах (G): протяните первую сторону от сустава, затем протяните ещё раз для второй"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角度，以度为单位（G）：从关节拖出第一条边，再拖一次画出第二条边"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "角度，以度為單位（G）：從關節拖出第一條邊，再拖一次畫出第二條邊"
          }
        }
      }
    },
