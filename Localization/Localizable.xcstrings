    "Swap A and B: each video keeps its In/Out, sync points, speed and drawings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A und B tauschen: Jedes Video behält Start/Ende, Sync-Punkte, Tempo und Zeichnungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercambiar A y B: cada vídeo conserva su entrada/salida, puntos de sincronía, velocidad y dibujos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échanger A et B : chaque vidéo garde ses début/fin, points de synchro, vitesse et dessins"
          }
        },
        "it": {
