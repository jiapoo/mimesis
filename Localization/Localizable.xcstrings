    "Photos didn't hand over the video. If it's in iCloud, wait for it to download and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos hat das Video nicht übergeben. Liegt es in iCloud, warte, bis es geladen ist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos no entregó el vídeo. Si está en iCloud, espera a que se descargue e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos n'a pas transmis la vidéo. Si elle est dans iCloud, attendez qu'elle se télécharge et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto non ha fornito il video. Se è su iCloud, attendi che venga scaricato e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から動画を受け取れませんでした。iCloud にある場合は、ダウンロードを待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 영상을 넘겨주지 않았습니다. iCloud에 있다면 다운로드를 기다린 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fotos não entregou o vídeo. Se ele estiver no iCloud, espere o download terminar e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Фото» не передало видео. Если оно в iCloud, дождитесь загрузки и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片没有交出视频。如果视频在 iCloud 中，请等它下载完再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片沒有交出影片。如果影片在 iCloud 中，請等它下載完再試一次。"
          }
        }
      }
    },
    "Pick a video from Photos as clip %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Video aus Fotos als Clip %@ wählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir un vídeo de Fotos como clip %@"
          }
        },
        "fr": {
          "stringUnit": {
