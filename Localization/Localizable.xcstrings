    "Drawings show on every frame. Tap for this frame only (W).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnungen erscheinen auf jedem Bild. Tippe für nur dieses Bild (W)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dibujos se ven en todos los fotogramas. Toca para solo este fotograma (W)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dessins s'affichent sur toutes les images. Touchez pour cette image seulement (W)."
          }
        },
        "it": {
          "stringUnit": {
