    "The backgrounds don't match: are both clips filmed at the same place?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hintergründe passen nicht: Wurden beide Clips am selben Ort gefilmt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fondos no coinciden: ¿se grabaron ambos clips en el mismo lugar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arrière-plans ne correspondent pas : les deux clips ont-ils été filmés au même endroit ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sfondi non coincidono: entrambe le clip sono state filmate nello stesso posto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が一致しません：両方のクリップは同じ場所で撮影されていますか？"
          }
