            "state": "translated",
            "value": "Un PDF de chaque segment : ses images marquées, dessins, angles et notes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF di ogni segmento: i fotogrammi segnati, i disegni, gli angoli e le note"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての区間の PDF：マークしたフレーム、描画、角度、メモ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 구간의 PDF: 표시한 프레임, 그림, 각도, 메모"
          }
        },
        "pt-BR": {
          "stringUnit": {
