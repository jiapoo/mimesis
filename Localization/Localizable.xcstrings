    "Drag a handle to trim. Hold it still for a moment to zoom in and set the cut frame by frame.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe einen Griff zum Schneiden. Halte ihn kurz still, um heranzuzoomen und den Schnitt Bild für Bild zu setzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un tirador para recortar. Mantenlo quieto un momento para ampliar y fijar el corte fotograma a fotograma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une poignée pour découper. Maintenez-la immobile un instant pour zoomer et régler la coupe image par image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una maniglia per tagliare. Tienila ferma un momento per ingrandire e impostare il taglio fotogramma per fotogramma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグしてトリム。少し押したままにすると拡大し、1 コマずつ切り位置を設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 드래그해 트림합니다. 잠시 누르고 있으면 확대되어 프레임 단위로 자를 위치를 정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma alça para cortar. Segure-a parada por um instante para ampliar e definir o corte quadro a quadro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите маркер, чтобы обрезать. Задержите его на мгновение, чтобы увеличить и задать срез по кадрам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移手柄进行修剪。按住不动片刻可放大，逐帧设置剪切点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移控點進行修剪。按住不動片刻可放大，逐格設定剪接點。"
          }
        }
      }
    },
    "Drag one arm from the joint, then drag again for the other": {
      "extractionState": "manual",
