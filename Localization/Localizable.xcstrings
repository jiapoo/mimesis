    "Both clips are closed. Changes not saved in a project are lost.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Clips sind geschlossen. Änderungen, die nicht in einem Projekt gesichert sind, gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos clips están cerrados. Los cambios no guardados en un proyecto se pierden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux clips sont fermés. Les modifications non enregistrées dans un projet sont perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le clip sono chiuse. Le modifiche non salvate in un progetto vanno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のクリップが閉じられました。プロジェクトに保存していない変更は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 클립이 모두 닫혔습니다. 프로젝트로 저장하지 않은 변경 사항은 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois clipes foram fechados. As alterações não salvas em um projeto são perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба клипа закрыты. Изменения, не сохранённые в проекте, будут потеряны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个视频都已关闭。未保存为项目的更改会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
