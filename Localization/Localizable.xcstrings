    "No key frames yet: add a sync point, a drawing or a note on a frame, or take a snapshot.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Schlüsselbilder: Setze einen Sync-Punkt, eine Zeichnung oder eine Notiz auf ein Bild, oder mache einen Schnappschuss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay fotogramas clave: añade un punto de sincronía, un dibujo o una nota en un fotograma, o haz una instantánea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'images clés : ajoutez un point de synchro, un dessin ou une note sur une image, ou prenez un instantané."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun fotogramma chiave: aggiungi un punto sincro, un disegno o una nota su un fotogramma, o scatta un'istantanea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーフレームはまだありません：フレームに同期点、描画、メモを追加するか、スナップショットを撮ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 키 프레임이 없습니다: 프레임에 동기점, 그림, 메모를 추가하거나 스냅샷을 찍으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há quadros-chave: adicione um ponto de sincronia, um desenho ou uma nota em um quadro, ou tire um instantâneo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключевых кадров пока нет: добавьте на кадр синхроточку, рисунок или заметку либо сделайте снимок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有关键帧：在某一帧上添加同步点、绘图或备注，或拍一张快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有關鍵影格：在某一格上加入同步點、繪圖或備註，或拍一張快照。"
          }
        }
      }
    },
