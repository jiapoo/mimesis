        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경이 맞지 않습니다: 두 클립을 같은 장소에서 촬영했나요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fundos não coincidem: os dois clipes foram filmados no mesmo lugar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоны не совпадают: оба клипа сняты в одном месте?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景不匹配：两个视频是在同一地点拍摄的吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景不相符：兩部影片是在同一地點拍攝的嗎？"
