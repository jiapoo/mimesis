      }
    },
    "Line up the backgrounds: for two clips filmed at the same place, so everything that stands still matches": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergründe ausrichten: für zwei am selben Ort gefilmte Clips, damit alles Unbewegte übereinstimmt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinear los fondos: para dos clips grabados en el mismo lugar, para que todo lo que está quieto coincida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligner les arrière-plans : pour deux clips filmés au même endroit, afin que tout ce qui est immobile coïncide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allinea gli sfondi: per due clip filmate nello stesso posto, così tutto ciò che è fermo coincide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景をそろえる：同じ場所で撮った 2 つのクリップで、静止しているものをすべて一致させます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 맞추기: 같은 장소에서 찍은 두 클립에서 움직이지 않는 것이 모두 겹치게 합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhar os fundos: para dois clipes filmados no mesmo lugar, para que tudo o que está parado coincida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совместить фоны: для двух клипов, снятых в одном месте, чтобы всё неподвижное совпало"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对齐背景：适用于在同一地点拍摄的两个视频，让所有静止的东西重合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對齊背景：適用於在同一地點拍攝的兩部影片，讓所有靜止的東西重合"
          }
        }
      }
    },
    "Line up the bodies: put %@'s hips and feet on %@'s, from the frames on screen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körper ausrichten: Hüften und Füße von %1$@ auf die von %2$@ legen, anhand der Bilder auf dem Bildschirm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Line up the bodies: put %1$@'s hips and feet on %2$@'s, from the frames on screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinear los cuerpos: poner las caderas y los pies de %1$@ sobre los de %2$@, a partir de los fotogramas en pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligner les corps : placer les hanches et les pieds de %1$@ sur ceux de %2$@, d'après les images à l'écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allinea i corpi: metti anche e piedi di %1$@ su quelli di %2$@, dai fotogrammi sullo schermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体をそろえる：画面上のフレームから、%1$@ の腰と足を %2$@ に合わせます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸 맞추기: 화면의 프레임을 기준으로 %1$@의 엉덩이와 발을 %2$@에 맞춥니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhar os corpos: pôr o quadril e os pés de %1$@ sobre os de %2$@, a partir dos quadros na tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совместить тела: поставить бёдра и ступни %1$@ на место %2$@ по кадрам на экране"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对齐身体：根据屏幕上的帧，把 %1$@ 的髋部和双脚放到 %2$@ 的位置上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對齊身體：根據螢幕上的影格，把 %1$@ 的髖部和雙腳放到 %2$@ 的位置上"
          }
        }
      }
    },
    "Lining up needs a real iPhone or iPad (Vision can't run it in Simulator).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausrichten braucht ein echtes iPhone oder iPad (Vision läuft nicht im Simulator)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinear requiere un iPhone o iPad real (Vision no puede ejecutarlo en el simulador)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alignement nécessite un vrai iPhone ou iPad (Vision ne peut pas l'exécuter dans le Simulateur)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allineamento richiede un vero iPhone o iPad (Vision non funziona nel Simulatore)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置合わせには実機の iPhone または iPad が必要です（シミュレータでは Vision を実行できません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞추기에는 실제 iPhone 또는 iPad가 필요합니다(시뮬레이터에서는 Vision을 실행할 수 없습니다)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhar precisa de um iPhone ou iPad de verdade (o Vision não roda no Simulador)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для совмещения нужен настоящий iPhone или iPad (Vision не работает в симуляторе)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对齐需要真实的 iPhone 或 iPad（模拟器中无法运行 Vision）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對齊需要真實的 iPhone 或 iPad（模擬器中無法執行 Vision）。"
          }
        }
      }
    },
    "Linked: choose A or B to change In, Out or sync points.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpft: Wähle A oder B, um Start, Ende oder Sync-Punkte zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculados: elige A o B para cambiar la entrada, la salida o los puntos de sincronía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liés : choisissez A ou B pour changer le début, la fin ou les points de synchro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegate: scegli A o B per cambiare inizio, fine o punti sincro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連動中：イン点、アウト点、同期点を変えるには A か B を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연동됨: 시작점, 끝점, 동기점을 바꾸려면 A나 B를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculados: escolha A ou B para mudar a entrada, a saída ou os pontos de sincronia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связаны: выберите A или B, чтобы изменить начало, конец или синхроточки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已联动：选择 A 或 B 来修改入点、出点或同步点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連動：選擇 A 或 B 來更改入點、出點或同步點。"
          }
        }
      }
    },
