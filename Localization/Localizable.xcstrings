          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início deste clipe no segmento: o cursor ([). Os dois inícios se alinham."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало этого клипа в отрезке: указатель ([). Два начала выравниваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频在片段中的开始点：播放头（[）。两个开始点会对齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影片在片段中的開始點：播放頭（[）。兩個開始點會對齊。"
          }
        }
      }
    },
