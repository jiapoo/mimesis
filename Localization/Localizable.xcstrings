    "Every clip you open is kept here. Tag moments with the tag button on a clip.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder geöffnete Clip wird hier aufbewahrt. Markiere Momente mit der Tag-Taste eines Clips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se guarda cada clip que abres. Etiqueta momentos con el botón de etiqueta de un clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque clip ouvert est conservé ici. Marquez des moments avec le bouton d'étiquette d'un clip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni clip che apri resta qui. Etichetta i momenti con il pulsante etichetta di una clip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたクリップはすべてここに保存されます。クリップのタグボタンで瞬間にタグを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연 클립은 모두 여기에 보관됩니다. 클립의 태그 버튼으로 순간에 태그를 붙이세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo clipe que você abre fica guardado aqui. Marque momentos com o botão de etiqueta de um clipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь хранится каждый открытый клип. Отмечайте моменты кнопкой тега на клипе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开过的每个视频都保存在这里。用视频上的标签按钮标记时刻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開過的每部影片都保存在這裡。用影片上的標籤按鈕標記時刻。"
          }
        }
      }
    },
