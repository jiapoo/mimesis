    "Clip %@'s person at %lld moments across its sync points (%@ – %@), in one picture. Pick a person in the overlay if others are in frame.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person in Clip %1$@ zu %2$lld Momenten zwischen seinen Sync-Punkten (%3$@ – %4$@), in einem Bild. Wähle eine Person im Overlay, wenn andere im Bild sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Clip %1$@'s person at %2$lld moments across its sync points (%3$@ – %4$@), in one picture. Pick a person in the overlay if others are in frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona del clip %1$@ en %2$lld momentos entre sus puntos de sincronía (%3$@ – %4$@), en una sola imagen. Elige una persona en el superpuesto si hay otras en el encuadre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne du clip %1$@ à %2$lld moments entre ses points de synchro (%3$@ – %4$@), en une seule image. Choisissez une personne dans la superposition si d'autres sont dans le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona della clip %1$@ in %2$lld momenti tra i suoi punti sincro (%3$@ – %4$@), in un'unica immagine. Scegli una persona nella sovrapposizione se ce ne sono altre nell'inquadratura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップ %1$@ の人物を、同期点の間の %2$lld 個の瞬間（%3$@ – %4$@）で 1 枚の画像に。ほかの人が映っている場合はオーバーレイで人物を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립 %1$@의 인물을 동기점 사이의 %2$lld개 순간(%3$@ – %4$@)으로 한 장의 그림에. 다른 사람이 화면에 있으면 오버레이에서 인물을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa do clipe %1$@ em %2$lld momentos entre os pontos de sincronia (%3$@ – %4$@), em uma imagem. Escolha uma pessoa na sobreposição se houver outras no quadro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человек из клипа %1$@ в %2$lld моментах между синхроточками (%3$@ – %4$@) на одном изображении. Если в кадре есть другие люди, выберите человека в наложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频 %1$@ 中的人物在其同步点之间的 %2$lld 个时刻（%3$@ – %4$@），合成一张图片。若画面中有其他人，请在叠加中选择一个人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片 %1$@ 中的人物在其同步點之間的 %2$lld 個時刻（%3$@ – %4$@），合成一張圖片。若畫面中有其他人，請在疊加中選擇一個人。"
          }
        }
      }
    },
    "Clip %@'s person at %lld moments across its trim (%@ – %@), in one picture. Pick a person in the overlay if others are in frame.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person in Clip %1$@ zu %2$lld Momenten über seinen Schnitt (%3$@ – %4$@), in einem Bild. Wähle eine Person im Overlay, wenn andere im Bild sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Clip %1$@'s person at %2$lld moments across its trim (%3$@ – %4$@), in one picture. Pick a person in the overlay if others are in frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona del clip %1$@ en %2$lld momentos a lo largo de su recorte (%3$@ – %4$@), en una sola imagen. Elige una persona en el superpuesto si hay otras en el encuadre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne du clip %1$@ à %2$lld moments sur son découpage (%3$@ – %4$@), en une seule image. Choisissez une personne dans la superposition si d'autres sont dans le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona della clip %1$@ in %2$lld momenti lungo il suo taglio (%3$@ – %4$@), in un'unica immagine. Scegli una persona nella sovrapposizione se ce ne sono altre nell'inquadratura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップ %1$@ の人物を、トリム範囲の %2$lld 個の瞬間（%3$@ – %4$@）で 1 枚の画像に。ほかの人が映っている場合はオーバーレイで人物を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립 %1$@의 인물을 트림 범위의 %2$lld개 순간(%3$@ – %4$@)으로 한 장의 그림에. 다른 사람이 화면에 있으면 오버레이에서 인물을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa do clipe %1$@ em %2$lld momentos ao longo do corte (%3$@ – %4$@), em uma imagem. Escolha uma pessoa na sobreposição se houver outras no quadro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человек из клипа %1$@ в %2$lld моментах по всей обрезке (%3$@ – %4$@) на одном изображении. Если в кадре есть другие люди, выберите человека в наложении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频 %1$@ 中的人物在其修剪范围内的 %2$lld 个时刻（%3$@ – %4$@），合成一张图片。若画面中有其他人，请在叠加中选择一个人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片 %1$@ 中的人物在其修剪範圍內的 %2$lld 個時刻（%3$@ – %4$@），合成一張圖片。若畫面中有其他人，請在疊加中選擇一個人。"
          }
        }
      }
    },
