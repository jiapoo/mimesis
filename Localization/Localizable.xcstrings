    "Play stops at the end. Click to loop: back to the start and on (⌥L).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe stoppt am Ende. Klicke für Endlos: zurück zum Anfang und weiter (⌥L)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción se detiene al final. Haz clic para repetir en bucle: vuelta al inicio y sigue (⌥L)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture s'arrête à la fin. Cliquez pour boucler : retour au début et on continue (⌥L)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione si ferma alla fine. Fai clic per il loop: torna all'inizio e prosegue (⌥L)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後で再生を止めます。クリックでループ：最初に戻って続けます（⌥L）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝에서 재생이 멈춥니다. 클릭하면 반복: 처음으로 돌아가 계속합니다(⌥L)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução para no fim. Clique para repetir em loop: volta ao início e continua (⌥L)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение останавливается в конце. Нажмите для повтора по кругу: к началу и дальше (⌥L)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放到结尾时停止。点按改为循环：回到开头继续（⌥L）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放到結尾時停止。按一下改為循環：回到開頭繼續（⌥L）。"
          }
        }
      }
    },
