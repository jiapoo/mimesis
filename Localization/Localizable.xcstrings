        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar A e B: cada vídeo mantém sua entrada/saída, pontos de sincronia, velocidade e desenhos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
