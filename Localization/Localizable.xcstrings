    "Each clip's own time (at its real speed) from its In to each sync point, and to its Out": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Zeit jedes Clips (in echtem Tempo) von seinem Start bis zu jedem Sync-Punkt und bis zu seinem Ende"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo propio de cada clip (a su velocidad real) desde su entrada hasta cada punto de sincronía, y hasta su salida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps propre de chaque clip (à sa vraie vitesse) de son début à chaque point de synchro, et jusqu'à sa fin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo proprio di ogni clip (alla sua velocità reale) dall'inizio a ogni punto sincro, e fino alla fine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各クリップ自体の時間（実際の速度）：イン点から各同期点まで、そしてアウト点まで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 클립 자체의 시간(실제 속도): 시작점부터 각 동기점까지, 그리고 끝점까지"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo próprio de cada clipe (na velocidade real) da entrada até cada ponto de sincronia, e até a saída"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственное время каждого клипа (на его реальной скорости) от начала до каждой синхроточки и до конца"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个视频以真实速度计算，从入点到每个同步点以及到出点的时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每部影片以實際速度計算，從入點到每個同步點以及到出點的時間"
          }
        }
      }
    },
