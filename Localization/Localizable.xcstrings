    "Film in Slo-mo (240 fps), or at least 60 fps, for smooth slow motion": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme in Zeitlupe (240 fps) oder mit mindestens 60 fps für flüssige Zeitlupe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba en cámara lenta (240 fps), o al menos a 60 fps, para una cámara lenta fluida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez au ralenti (240 i/s), ou au moins à 60 i/s, pour un ralenti fluide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filma in slow motion (240 fps), o almeno a 60 fps, per un rallentatore fluido"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なめらかなスローモーションには、スロー（240 fps）か 60 fps 以上で撮影してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 슬로 모션을 위해 슬로 모션(240 fps) 또는 60 fps 이상으로 촬영하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme em câmera lenta (240 fps), ou pelo menos a 60 fps, para uma câmera lenta suave"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте в режиме «Замедленно» (240 к/с) или хотя бы 60 к/с для плавного замедления"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用慢动作（240 fps）或至少 60 fps 拍摄，慢放才会流畅"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用慢動作（240 fps）或至少 60 fps 拍攝，慢放才會流暢"
          }
        }
      }
    },
    "Film with this device and watch each attempt again a few seconds later, hands-free": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme mit diesem Gerät und sieh jeden Versuch ein paar Sekunden später freihändig noch einmal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba con este dispositivo y vuelve a ver cada intento unos segundos después, sin manos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez avec cet appareil et revoyez chaque essai quelques secondes plus tard, sans les mains"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filma con questo dispositivo e rivedi ogni tentativo qualche secondo dopo, senza mani"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで撮影し、数秒後に各試技を手を使わずに見返します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기로 촬영하고 몇 초 뒤 손을 쓰지 않고 각 시도를 다시 봅니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme com este aparelho e reveja cada tentativa alguns segundos depois, sem as mãos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте этим устройством и пересматривайте каждую попытку через несколько секунд без рук"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用本设备拍摄，几秒后免手动地重看每一次尝试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用本裝置拍攝，幾秒後免動手地重看每一次嘗試"
          }
        }
      }
    },
