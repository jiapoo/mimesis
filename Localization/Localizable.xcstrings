    "Edit this clip: turn, flip, crop or trim it (⌘T). The clip becomes the edited copy; the original isn't changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Clip bearbeiten: drehen, spiegeln, zuschneiden oder kürzen (⌘T). Der Clip wird zur bearbeiteten Kopie; das Original bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar este clip: girar, voltear, recortar o acortar (⌘T). El clip pasa a ser la copia editada; el original no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier ce clip : le pivoter, le retourner, le recadrer ou le découper (⌘T). Le clip devient la copie modifiée ; l'original n'est pas changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questa clip: ruota, rifletti, ritaglia o taglia (⌘T). La clip diventa la copia modificata; l'originale non cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクリップを編集：回転、反転、切り取り、トリム（⌘T）。クリップは編集したコピーに置き換わり、元の動画は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 클립 편집: 회전, 뒤집기, 자르기, 트림(⌘T). 클립은 편집한 사본으로 바뀌고 원본은 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar este clipe: girar, espelhar, recortar ou cortar (⌘T). O clipe passa a ser a cópia editada; o original não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить этот клип: повернуть, отразить, кадрировать или обрезать (⌘T). Клип станет изменённой копией; оригинал не меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑此视频：旋转、翻转、裁剪或修剪（⌘T）。视频会替换为编辑后的副本，原始文件不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯此影片：旋轉、翻轉、裁切或修剪（⌘T）。影片會換成編輯後的副本，原始檔案不變。"
          }
        }
      }
    },
