    "Filmed at %lld frames a second: slow motion will jump. Film in Slo-mo (240 fps) or at least 60 fps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %lld Bildern pro Sekunde gefilmt: Die Zeitlupe ruckelt. Filme in Zeitlupe (240 fps) oder mit mindestens 60 fps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabado a %lld fotogramas por segundo: la cámara lenta irá a saltos. Graba en cámara lenta (240 fps) o al menos a 60 fps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmé à %lld images par seconde : le ralenti sera saccadé. Filmez au ralenti (240 i/s) ou au moins à 60 i/s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmato a %lld fotogrammi al secondo: il rallentatore andrà a scatti. Filma in slow motion (240 fps) o almeno a 60 fps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎秒 %lld フレームで撮影：スローモーションがカクつきます。スロー（240 fps）か 60 fps 以上で撮影してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초당 %lld프레임으로 촬영됨: 슬로 모션이 끊깁니다. 슬로 모션(240 fps) 또는 60 fps 이상으로 촬영하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmado a %lld quadros por segundo: a câmera lenta vai pular. Filme em câmera lenta (240 fps) ou pelo menos a 60 fps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снято с частотой %lld кадров в секунду: замедление будет рывками. Снимайте в режиме «Замедленно» (240 к/с) или хотя бы 60 к/с."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以每秒 %lld 帧拍摄：慢放会跳帧。请用慢动作（240 fps）或至少 60 fps 拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以每秒 %lld 格拍攝：慢放會跳格。請用慢動作（240 fps）或至少 60 fps 拍攝。"
          }
        }
      }
    },
