          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un video da Foto come clip %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から動画をクリップ %@ として選ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에서 영상을 골라 클립 %@(으)로"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher um vídeo do Fotos como clipe %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать видео из «Фото» как клип %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从照片中选择一个视频作为视频 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從照片中選擇一部影片作為影片 %@"
          }
        }
      }
    },
    "Pin a note to the frame clip %@ is showing: it appears over the clip around that moment, and in exported videos": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Notiz an das Bild heften, das Clip %@ zeigt: Sie erscheint um diesen Moment herum über dem Clip und in exportierten Videos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar una nota en el fotograma que muestra el clip %@: aparece sobre el clip en torno a ese momento y en los vídeos exportados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épingler une note à l'image affichée par le clip %@ : elle apparaît sur le clip autour de ce moment, et dans les vidéos exportées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa una nota sul fotogramma che la clip %@ sta mostrando: appare sulla clip attorno a quel momento e nei video esportati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップ %@ が表示しているフレームにメモをピン留め：その瞬間の前後にクリップの上に表示され、書き出した動画にも入ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립 %@이(가) 보여 주는 프레임에 메모 고정: 그 순간 전후로 클립 위에 표시되고 내보낸 영상에도 들어갑니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixar uma nota no quadro que o clipe %@ está mostrando: ela aparece sobre o clipe perto desse momento, e nos vídeos exportados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепить заметку на кадре, который показывает клип %@: она видна на клипе около этого момента и в экспортированных видео"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在视频 %@ 当前显示的帧上钉一条备注：它会在那一刻前后显示在视频上，也会出现在导出的视频中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在影片 %@ 目前顯示的影格上釘一則備註：它會在那一刻前後顯示在影片上，也會出現在輸出的影片中"
          }
        }
      }
    },
