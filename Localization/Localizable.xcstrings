    "%@ is cut out. With %@ on top, %@ is shown whole underneath, so its cutout is removed. You can cut %@ out afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist freigestellt. Mit %2$@ oben ist %3$@ darunter ganz zu sehen, daher wird seine Freistellung entfernt. Du kannst %4$@ danach freistellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is cut out. With %2$@ on top, %3$@ is shown whole underneath, so its cutout is removed. You can cut %4$@ out afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está recortado. Con %2$@ encima, %3$@ se ve entero debajo, así que se quita su recorte. Puedes recortar %4$@ después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est détouré. Avec %2$@ au-dessus, %3$@ apparaît entier dessous ; son détourage est donc supprimé. Vous pourrez détourer %4$@ ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è scontornato. Con %2$@ sopra, %3$@ si vede intero sotto, quindi il suo scontorno viene rimosso. Puoi scontornare %4$@ dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は切り抜かれています。%2$@ を上にすると %3$@ は下に全体が表示されるため、切り抜きは削除されます。あとで %4$@ を切り抜くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 배경이 제거되어 있습니다. %2$@을(를) 위로 올리면 %3$@은(는) 아래에 전체가 보이므로 배경 제거가 삭제됩니다. 나중에 %4$@의 배경을 제거할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está recortado. Com %2$@ por cima, %3$@ aparece inteiro embaixo, então o recorte dele é removido. Você pode recortar %4$@ depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ вырезан. Если сверху будет %2$@, %3$@ будет виден снизу целиком, поэтому его вырезка удаляется. Потом можно вырезать %4$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已抠出。把 %2$@ 放在上层后，%3$@ 会在下层完整显示，所以它的抠像会被移除。之后可以再抠出 %4$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已去背。把 %2$@ 放在上層後，%3$@ 會在下層完整顯示，所以它的去背會被移除。之後可以再為 %4$@ 去背。"
          }
        }
      }
    },
    "%@ is on top of %@, see-through. Click to put %@ on top instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt durchscheinend über %2$@. Klicke, um stattdessen %3$@ nach oben zu legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is on top of %2$@, see-through. Click to put %3$@ on top instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está sobre %2$@, semitransparente. Haz clic para poner %3$@ encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est au-dessus de %2$@, en transparence. Cliquez pour mettre %3$@ au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è sopra %2$@, semitrasparente. Fai clic per mettere sopra %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ の上に半透明で重なっています。クリックすると %3$@ を上にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@ 위에 반투명하게 겹쳐 있습니다. 클릭하면 %3$@을(를) 위로 올립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está sobre %2$@, translúcido. Clique para colocar %3$@ por cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ лежит поверх %2$@, полупрозрачно. Нажмите, чтобы наверх положить %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 半透明地叠在 %2$@ 上。点按改为把 %3$@ 放在上层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 半透明地疊在 %2$@ 上。按一下改為把 %3$@ 放在上層。"
          }
        }
      }
    },
    "%@ is on top, and is the one cut out. Tap to put %@ on top instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt oben und ist freigestellt. Tippe, um stattdessen %2$@ nach oben zu legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is on top, and is the one cut out. Tap to put %2$@ on top instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está encima y es el recortado. Toca para poner %2$@ encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est au-dessus et c'est lui qui est détouré. Touchez pour mettre %2$@ au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è sopra ed è quello scontornato. Tocca per mettere sopra %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が上にあり、切り抜かれています。タップすると %2$@ を上にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 위에 있고 배경이 제거된 클립입니다. 탭하면 %2$@을(를) 위로 올립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está por cima e é o recortado. Toque para colocar %2$@ por cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сверху, и он вырезан. Коснитесь, чтобы наверх положить %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在上层，也是被抠出的那个。轻点改为把 %2$@ 放在上层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在上層，也是被去背的那個。點一下改為把 %2$@ 放在上層。"
          }
        }
      }
    },
