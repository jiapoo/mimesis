    "The linked span, both clips lined up at their sync points, at %@ (set the speed on the transport for slow motion).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verknüpfte Bereich, beide Clips an ihren Sync-Punkten ausgerichtet, mit %@ (stelle das Tempo in der Wiedergabesteuerung für Zeitlupe ein)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tramo vinculado, ambos clips alineados en sus puntos de sincronía, a %@ (ajusta la velocidad en los controles de reproducción para cámara lenta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plage liée, les deux clips alignés sur leurs points de synchro, à %@ (réglez la vitesse dans les commandes de lecture pour le ralenti)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tratto collegato, entrambe le clip allineate ai punti sincro, a %@ (imposta la velocità nei controlli di riproduzione per il rallentatore)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連動範囲。両方のクリップを同期点でそろえ、速度 %@（スローモーションはトランスポートで速度を設定）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연동 범위. 두 클립을 동기점에서 맞추고 속도 %@(슬로 모션은 재생 컨트롤에서 속도를 설정)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trecho vinculado, os dois clipes alinhados nos pontos de sincronia, a %@ (defina a velocidade nos controles de reprodução para câmera lenta)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанный участок, оба клипа выровнены по синхроточкам, на скорости %@ (для замедления задайте скорость в панели воспроизведения)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联动范围，两个视频在同步点对齐，速度 %@（慢放请在播放控制中设置速度）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連動範圍，兩部影片在同步點對齊，速度 %@（慢放請在播放控制中設定速度）。"
          }
        }
