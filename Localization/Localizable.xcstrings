    "%@ angle through the segment; the white line is the playhead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Winkel über den ganzen Abschnitt; die weiße Linie ist der Abspielkopf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ángulo de %@ a lo largo del segmento; la línea blanca es el cursor de reproducción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Angle %@ sur tout le segment ; la ligne blanche est la tête de lecture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Angolo di %@ lungo tutto il segmento; la linea bianca è la testina di riproduzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区間全体の%@の角度。白い線は再生ヘッドです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구간 전체의 %@ 각도. 흰 선은 재생 헤드입니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ângulo de %@ ao longo do segmento; a linha branca é o cursor de reprodução"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угол «%@» на всём отрезке; белая линия — указатель воспроизведения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整段中的%@角度；白线是播放头"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整段中的%@角度；白線是播放頭"
          }
        }
      }
    },
