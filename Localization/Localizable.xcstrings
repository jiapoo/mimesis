    "Set by hand. Tap, then Auto, to match the other clip again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Hand festgelegt. Tippe, dann Auto, um es wieder an den anderen Clip anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijada a mano. Toca y luego Auto para igualarla de nuevo al otro clip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglée à la main. Touchez, puis Auto, pour l'ajuster de nouveau à l'autre clip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostata a mano. Tocca, poi Auto, per adattarla di nuovo all'altra clip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で設定。タップして「自動」を選ぶと、もう一方のクリップに再び合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 설정됨. 탭한 다음 ‘자동’을 누르면 다시 다른 클립에 맞춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definida à mão. Toque e depois em Auto para igualar de novo ao outro clipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задано вручную. Коснитесь, затем «Авто», чтобы снова подогнать под другой клип."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动设置。轻点，再点“自动”，即可重新与另一视频匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動設定。點一下，再點「自動」，即可重新與另一部影片相符。"
          }
        }
