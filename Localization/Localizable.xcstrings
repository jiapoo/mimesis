    "Mirror %@ side to side, e.g. a right-hander to match a left-hander": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seitlich spiegeln, z. B. einen Rechtshänder passend zu einem Linkshänder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflejar %@ de lado a lado, p. ej. un diestro frente a un zurdo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverser %@ gauche-droite, p. ex. un droitier face à un gaucher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifletti %@ da un lato all'altro, ad es. un destrorso per confrontarlo con un mancino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を左右反転（右利きを左利きに合わせるなど）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 좌우 반전(예: 오른손잡이를 왼손잡이에 맞추기)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espelhar %@ de um lado para o outro, por exemplo um destro para combinar com um canhoto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отразить %@ слева направо, например правшу, чтобы сравнить с левшой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右镜像 %@，例如让右手持拍者与左手持拍者对应"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右鏡像 %@，例如讓右手持拍者與左手持拍者對應"
          }
        }
      }
    },
