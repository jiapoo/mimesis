          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックでこの区間を選択、ダブルクリックで名前を変更、右クリックでその他"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭해 이 구간 선택, 이중 클릭해 이름 변경, 오른쪽 클릭으로 더 보기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para escolher este segmento; clique duplo para renomear; clique direito para mais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы выбрать отрезок; дважды — чтобы переименовать; правой кнопкой — ещё"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按选择此片段；双击重命名；右键查看更多"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選擇此片段；按兩下重新命名；按右鍵查看更多"
          }
        }
      }
    },
