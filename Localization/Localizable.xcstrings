    "No body found in %@'s frame: step to a frame where the whole body shows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Körper im Bild von %@ gefunden: Gehe zu einem Bild, in dem der ganze Körper zu sehen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún cuerpo en el fotograma de %@: ve a un fotograma donde se vea el cuerpo entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun corps trouvé dans l'image de %@ : allez à une image où le corps entier est visible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun corpo trovato nel fotogramma di %@: vai a un fotogramma in cui si vede tutto il corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のフレームに体が見つかりません：全身が映っているフレームへ移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 프레임에서 몸을 찾지 못했습니다: 몸 전체가 보이는 프레임으로 이동하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum corpo encontrado no quadro de %@: vá para um quadro em que o corpo inteiro aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В кадре %@ тело не найдено: перейдите к кадру, где видно всё тело."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的帧中没有找到身体：请移到能看到完整身体的帧。"
          }
